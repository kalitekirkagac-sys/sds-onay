# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.

# Supabase > Settings > API
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (service_role key - gizli tutun!)

# Yönetim paneli şifresi
ADMIN_PASSWORD=GüçlüBirSifre123

# Oturum imzalama anahtarı (rastgele uzun bir metin)
SESSION_SECRET=rastgele-uzun-bir-anahtar

# Site adresi (link üretiminde kullanılır, Vercel adresiniz)
PUBLIC_URL=https://projeniz.vercel.app
